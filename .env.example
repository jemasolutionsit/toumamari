# --- SUPABASE ---
# Expuesto al cliente para inicializar el SDK (solo lectura, protegido por RLS)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key"

# Secreto del servidor (NUNCA exponer en el frontend): lo usan los endpoints
# /api/* para escribir reservas y mensajes de contacto
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# --- CORREO (RESEND) ---
# Envío de avisos al negocio y confirmaciones al viajero
RESEND_API_KEY="tu-resend-api-key"

# Opcional: casilla(s) que reciben los avisos del negocio, separadas por comas.
# Si no se define, se usa info@touamamari.com (ver api/_lib/store.ts).
# NOTIFY_EMAIL="info@touamamari.com"
